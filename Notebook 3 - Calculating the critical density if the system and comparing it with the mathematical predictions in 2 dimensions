   "source": [
    "from scipy.optimize import brentq\n",
    "\n",
    "def F_final_size(rho, kappa, eps=1e-12):\n",
    "    \"\"\"Non-trivial root of F = 1 - exp(-rho*kappa*F), eq. 11. Returns 0 if rho*kappa <= 1.\"\"\"\n",
    "    lam = rho * kappa\n",
    "    if lam <= 1.0:\n",
    "        return 0.0                       # only the trivial root F = 0 exists\n",
    "    g = lambda F: F - (1.0 - np.exp(-lam * F))\n",
    "    return brentq(g, eps, 1.0)           # g(eps) < 0 and g(1) = exp(-lam) > 0\n",
    "\n",
    "def F_fixed_point(rho, kappa, F0=1e-3, tol=1e-12, max_iter=1_000_000):\n",
    "    \"\"\"Fixed-point iteration, eq. 12.\"\"\"\n",
    "    F = F0\n",
    "    for m in range(max_iter):\n",
    "        F_new = 1.0 - np.exp(-rho * kappa * F)\n",
    "        if abs(F_new - F) < tol:\n",
    "            return F_new, m\n",
    "        F = F_new\n",
    "    return F, max_iter\n",
    "\n",
    "# cross-check against the generation-by-generation iteration (section 5)\n",
    "kappa = 1.8\n",
    "for rho in (0.4, 0.6, 0.8, 1.0):\n",
    "    F_root = F_final_size(rho, kappa)\n",
    "    F_fp, n_fp = F_fixed_point(rho, kappa)\n",
    "    rho_f_inf, _ = iterate_mean_field(rho, kappa, L=200)\n",
    "    print(f\"rho={rho:.1f}  root={F_root:.6f}  fixed-pt={F_fp:.6f} ({n_fp} it)  \"\n",
    "          f\"section5={rho_f_inf/rho:.6f}\")"
   ]
